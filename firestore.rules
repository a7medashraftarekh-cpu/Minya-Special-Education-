rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signed() {
      return request.auth != null;
    }

    function doctorPath() {
      return /databases/$(database)/documents/settings/doctor;
    }

    // الدكتور = له مستند في doctors (ينشئه الليدر الرئيسي) أو هو أول دكتور قديم في settings/doctor
    function isDoctor() {
      return signed() && (
        exists(/databases/$(database)/documents/doctors/$(request.auth.uid))
        || (exists(doctorPath()) && get(doctorPath()).data.uid == request.auth.uid));
    }

    // الليدر = طالب تمت ترقيته (له مستند في leaders)
    function isLeader() {
      return signed() && exists(/databases/$(database)/documents/leaders/$(request.auth.uid));
    }

    function isStaff() {
      return isDoctor() || isLeader();
    }

    // الليدر الرئيسي = أول ليدر دخل الموقع، أعلى صلاحية
    function isMainLeader() {
      return isLeader()
        && exists(/databases/$(database)/documents/settings/mainLeader)
        && get(/databases/$(database)/documents/settings/mainLeader).data.uid == request.auth.uid;
    }

    // بدء وإنهاء وحذف المحاضرات والتحضير اليدوي: الدكتور (لمحاضراته) والليدر الرئيسي
    function isLecturer() {
      return isDoctor() || isMainLeader();
    }

    function userData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function myCode() {
      return ('code' in userData()) ? userData().code : '';
    }

    function codeOk(c) {
      return c is string && c.matches('^[0-9]{8}$');
    }

    function lectureData(lid) {
      return get(/databases/$(database)/documents/lectures/$(lid)).data;
    }

    // ---------- الإعدادات ----------
    match /settings/doctor {
      allow read: if true;
      allow create, update, delete: if false;
    }

    match /settings/mainLeader {
      allow read: if isStaff();
      allow create: if isLeader()
        && !exists(/databases/$(database)/documents/settings/mainLeader)
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.keys().hasOnly(['uid', 'createdAt'])
        && request.resource.data.createdAt == request.time;
      allow update, delete: if false;
    }

    // ---------- قائمة الطلاب (الكود الجامعي والاسم) ----------
    match /roster/{code} {
      allow get: if signed();
      allow list: if isStaff();
      allow create: if isStaff()
        && codeOk(code)
        && request.resource.data.keys().hasOnly(['code', 'name', 'gender', 'year', 'addedBy', 'createdAt'])
        && request.resource.data.code == code
        && request.resource.data.name is string
        && request.resource.data.name.size() >= 3
        && request.resource.data.name.size() <= 100
        && request.resource.data.gender in ['male', 'female', '']
        && request.resource.data.year is string
        && request.resource.data.year.size() <= 20
        && request.resource.data.addedBy == request.auth.uid
        && request.resource.data.createdAt == request.time;
      allow update: if isMainLeader()
        && request.resource.data.keys().hasOnly(['code', 'name', 'gender', 'year', 'addedBy', 'createdAt'])
        && request.resource.data.code == code
        && request.resource.data.name is string
        && request.resource.data.name.size() >= 3
        && request.resource.data.name.size() <= 100
        && request.resource.data.gender in ['male', 'female', '']
        && request.resource.data.year is string
        && request.resource.data.year.size() <= 20;
      allow delete: if isMainLeader();
    }

    // ---------- الحسابات ----------
    match /users/{id} {
      allow read: if signed() && (request.auth.uid == id || isStaff());

      // تسجيل الطالب بالكود الجامعي: الاسم يُؤخذ من قائمة الطلاب، والبريد الداخلي لازم يطابق الكود
      allow create: if signed()
        && request.auth.uid == id
        && request.resource.data.keys().hasOnly(['uid', 'code', 'name', 'role', 'status', 'createdAt'])
        && request.resource.data.uid == id
        && request.resource.data.role == 'student'
        && request.resource.data.status == 'incomplete'
        && codeOk(request.resource.data.code)
        && request.auth.token.email == request.resource.data.code + '@code.attendance.app'
        && exists(/databases/$(database)/documents/roster/$(request.resource.data.code))
        && get(/databases/$(database)/documents/roster/$(request.resource.data.code)).data.name == request.resource.data.name
        && request.resource.data.createdAt == request.time;

      // إعداد أول دكتور (قديم)، أو إنشاء الليدر الرئيسي لحساب دكتور
      allow create: if signed()
        && request.resource.data.keys().hasOnly(['uid', 'name', 'phoneMasked', 'role', 'status', 'createdAt'])
        && request.resource.data.uid == id
        && request.resource.data.role == 'doctor'
        && request.resource.data.status == 'approved'
        && request.resource.data.name is string
        && request.resource.data.name.size() >= 3
        && request.resource.data.name.size() <= 100
        && request.resource.data.phoneMasked is string
        && request.resource.data.phoneMasked.size() <= 15
        && ((request.auth.uid == id && isDoctor()) || isMainLeader());

      // الطالب يكمل بياناته مرة واحدة: النوع + الهاتف (مع الصورة)
      allow update: if signed()
        && request.auth.uid == id
        && resource.data.status == 'incomplete'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'gender', 'phoneMasked'])
        && request.resource.data.status == 'pending'
        && request.resource.data.gender in ['male', 'female']
        && request.resource.data.phoneMasked is string
        && request.resource.data.phoneMasked.size() <= 15
        && existsAfter(/databases/$(database)/documents/photos/$(id))
        && existsAfter(/databases/$(database)/documents/userPrivate/$(id));

      // الليدر الرئيسي: قبول/إزالة الحسابات وتعديل بياناتها بعد موافقته
      allow update: if isMainLeader()
        && resource.data.role == 'student'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'name', 'gender', 'phoneMasked'])
        && request.resource.data.status in ['approved', 'removed', 'pending']
        && request.resource.data.name is string
        && request.resource.data.name.size() <= 100
        && (!('gender' in request.resource.data) || request.resource.data.gender in ['male', 'female'])
        && (!('phoneMasked' in request.resource.data) || request.resource.data.phoneMasked is string);

      allow delete: if false;
    }

    // الرقم الكامل: يقرؤه صاحبه والليدر الرئيسي فقط
    match /userPrivate/{id} {
      allow read: if signed() && (request.auth.uid == id || isMainLeader());
      allow create: if signed()
        && (request.auth.uid == id || isMainLeader())
        && request.resource.data.keys().hasOnly(['uid', 'phone'])
        && request.resource.data.uid == id
        && request.resource.data.phone is string
        && request.resource.data.phone.size() <= 15;
      allow update: if isMainLeader()
        && request.resource.data.keys().hasOnly(['uid', 'phone'])
        && request.resource.data.uid == id
        && request.resource.data.phone is string
        && request.resource.data.phone.size() <= 15;
      allow delete: if false;
    }

    // الصورة الشخصية (JPEG صغيرة): صاحبها يضيفها مرة واحدة، ويراها الدكتور والليدرز عند المسح
    match /photos/{id} {
      allow get: if signed() && (request.auth.uid == id || isStaff());
      allow create: if signed()
        && request.auth.uid == id
        && request.resource.data.keys().hasOnly(['uid', 'data'])
        && request.resource.data.uid == id
        && request.resource.data.data is string
        && request.resource.data.data.size() < 150000
        && request.resource.data.data.matches('data:image/jpeg;base64,.*');
      allow update, delete: if false;
    }

    // طلبات تعديل الحسابات: يكتبها الطالب، ويقرؤها ويوافق عليها الليدر الرئيسي فقط
    match /editRequests/{id} {
      allow read: if signed() && (request.auth.uid == id || isMainLeader());
      allow create, update: if signed()
        && request.auth.uid == id
        && userData().status == 'approved'
        && request.resource.data.keys().hasOnly(['uid', 'name', 'phone', 'gender', 'status', 'createdAt'])
        && request.resource.data.uid == id
        && request.resource.data.status == 'pending'
        && request.resource.data.name is string
        && request.resource.data.name.size() >= 3
        && request.resource.data.name.size() <= 100
        && request.resource.data.phone is string
        && request.resource.data.phone.size() >= 10
        && request.resource.data.phone.size() <= 15
        && request.resource.data.gender in ['male', 'female']
        && request.resource.data.createdAt == request.time;
      allow update: if isMainLeader()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status'])
        && request.resource.data.status == 'rejected';
      allow delete: if signed() && (request.auth.uid == id || isMainLeader());
    }

    // ---------- الدكاترة والمواد (يديرها الليدر الرئيسي) ----------
    match /doctors/{id} {
      allow get: if signed() && (request.auth.uid == id || isStaff());
      allow list: if isStaff();
      allow create: if isMainLeader()
        && request.resource.data.keys().hasOnly(['uid', 'name', 'createdBy', 'createdAt'])
        && request.resource.data.uid == id
        && request.resource.data.name is string
        && request.resource.data.name.size() <= 100
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.createdAt == request.time;
      allow update: if false;
      allow delete: if isMainLeader();
    }

    match /courses/{id} {
      allow read: if isStaff();
      allow create: if isMainLeader()
        && request.resource.data.keys().hasOnly(['name', 'doctorId', 'doctorName', 'createdBy', 'createdAt'])
        && request.resource.data.name is string
        && request.resource.data.name.size() >= 2
        && request.resource.data.name.size() <= 100
        && request.resource.data.doctorId is string
        && request.resource.data.doctorName is string
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.createdAt == request.time;
      allow update: if false;
      allow delete: if isMainLeader();
    }

    // ---------- الليدرز ----------
    // يرقّيهم الليدر الرئيسي فقط ويلغيهم هو فقط (استثناء: الدكتور القديم يرقّي أول ليدر قبل وجود رئيسي)
    match /leaders/{id} {
      allow read: if signed() && (request.auth.uid == id || isStaff());
      allow create: if signed()
        && request.resource.data.keys().hasOnly(['uid', 'name', 'promotedBy', 'createdAt'])
        && request.resource.data.uid == id
        && request.resource.data.name is string
        && request.resource.data.promotedBy == request.auth.uid
        && request.resource.data.createdAt == request.time
        && exists(/databases/$(database)/documents/users/$(id))
        && get(/databases/$(database)/documents/users/$(id)).data.role == 'student'
        && ((isMainLeader() && get(/databases/$(database)/documents/users/$(id)).data.status == 'approved')
            || (isDoctor() && !exists(/databases/$(database)/documents/settings/mainLeader)));
      allow update: if false;
      allow delete: if isMainLeader() && id != request.auth.uid;
    }

    // ---------- المحاضرات ----------
    match /lectures/{id} {
      allow get: if signed();
      allow list: if isStaff();
      allow create: if isLecturer()
        && request.resource.data.title is string
        && request.resource.data.title.size() <= 100
        && (isMainLeader() || request.resource.data.doctorId == request.auth.uid);
      allow update: if isLecturer()
        && request.resource.data.title is string
        && request.resource.data.title.size() <= 100
        && (isMainLeader() || resource.data.doctorId == request.auth.uid);
      allow delete: if isLecturer()
        && (isMainLeader() || resource.data.doctorId == request.auth.uid);
    }

    // ---------- الحضور: رقمه lectureId_الكود الجامعي فلا يتكرر ----------
    match /attendance/{id} {
      allow get, list: if isStaff()
        || (signed() && resource.data.studentCode == myCode());

      // تسجيل بمسح الكارنيه/الكود (الدكتور لمحاضرته، أو أي ليدر) أو تحضير يدوي (الدكتور لمحاضرته، أو الليدر الرئيسي)
      allow create: if isStaff()
        && request.resource.data.keys().hasOnly(
             ['lectureId', 'courseId', 'courseName', 'doctorId', 'studentCode', 'studentName', 'gender', 'lectureTitle', 'status', 'method', 'by'])
        && request.resource.data.lectureId is string
        && request.resource.data.lectureId.size() <= 40
        && codeOk(request.resource.data.studentCode)
        && id == request.resource.data.lectureId + '_' + request.resource.data.studentCode
        && exists(/databases/$(database)/documents/roster/$(request.resource.data.studentCode))
        && get(/databases/$(database)/documents/roster/$(request.resource.data.studentCode)).data.name == request.resource.data.studentName
        && request.resource.data.gender in ['male', 'female', '']
        && request.resource.data.lectureTitle is string
        && request.resource.data.lectureTitle.size() <= 60
        && request.resource.data.status == 'present'
        && request.resource.data.by == request.auth.uid
        && request.resource.data.courseId == lectureData(request.resource.data.lectureId).courseId
        && request.resource.data.doctorId == lectureData(request.resource.data.lectureId).doctorId
        && ((request.resource.data.method in ['scan', 'code']
             && lectureData(request.resource.data.lectureId).status == 'active'
             && request.time < lectureData(request.resource.data.lectureId).endAt
             && (isLeader() || lectureData(request.resource.data.lectureId).doctorId == request.auth.uid))
            || (request.resource.data.method == 'manual'
                && isLecturer()
                && (isMainLeader() || lectureData(request.resource.data.lectureId).doctorId == request.auth.uid)));

      allow update: if false;
      // إزالة سجل حضور: الليدر الرئيسي فقط
      allow delete: if isMainLeader();
    }

    // وقت التسجيل: يقرؤه الليدر الرئيسي والطالب صاحبه فقط
    match /attendanceTimes/{id} {
      allow get, list: if signed()
        && (isMainLeader() || resource.data.studentCode == myCode());
      allow create: if isStaff()
        && request.resource.data.keys().hasOnly(['lectureId', 'studentCode', 'createdAt'])
        && request.resource.data.lectureId is string
        && request.resource.data.lectureId.size() <= 40
        && codeOk(request.resource.data.studentCode)
        && id == request.resource.data.lectureId + '_' + request.resource.data.studentCode
        && request.resource.data.createdAt == request.time
        && existsAfter(/databases/$(database)/documents/attendance/$(id));
      allow update: if false;
      allow delete: if isMainLeader();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
